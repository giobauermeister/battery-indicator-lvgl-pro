<component>
	<previews>
		<preview width="410" height="502" style_radius="140" />
	</previews>

	<styles>
		<style
			name="style_main"
			border_width="0"
			bg_color="0x505050"
			radius="0"
			pad_all="0"
		/>
	</styles>
	<view
		width="100%"
		height="60"
		scrollable="false"
		style_pad_left="90"
		style_pad_right="90"
	>
		<style name="style_main" />
		<clock align="left_mid" />

		<!-- Keep one indicator active. To compare, comment out V3 and uncomment an alternative below. -->

		<!--
			battery: classic iOS outline, implemented entirely in XML.
			Green fill, red at 20% or less, yellow in low power mode, and a charging icon.
			Uses global subjects directly; no percentage display or theme switching.
		-->
		<!-- <battery align="right_mid" /> -->

		<!--
			battery_indicator_2: XML pill design with an always-visible percentage.
			Uses global subjects for the level, low power color, charging icon, and full-charge tip.
			Normal fill stays green; no white idle state, outline mode, or theme switching.
		-->
		<!-- <battery_indicator_2 align="right_mid" /> -->

		<!--
			battery_indicator_v2: XML outline prototype with a lightning-shaped charging mask.
			Uses global subjects, with green fill, red at 20% or less, and yellow in low power mode.
			Outline only; no percentage display or theme switching.
		-->
		<!-- <battery_indicator_v2 align="right_mid" /> -->

		<!--
			wd_battery: custom widget with an XML layout and C behavior.
			Always shows the percentage; adds a white idle fill, green charging fill, and icon recoloring.
			Subjects are supplied through bind_* properties; fixed 20% threshold and no theme switching.
		-->
		<!-- <wd_battery
			bind_charging="battery_charging"
			bind_low_power="low_power_mode"
			bind_value="battery_value"
			align="right_mid"
		/> -->

		<!--
			wd_battery_v2: full-featured custom widget with XML layout and C behavior.
			Supports outline/percentage modes, a charging mask, light/dark themes, and an adjustable threshold.
			Uses custom setters and bind_* functions to follow the supplied subjects.
		-->
		<!-- <wd_battery_v2
			low_threshold="20"
			align="right_mid"
			bind_value="battery_value"
			bind_charging="battery_charging"
			bind_low_power="low_power_mode"
			bind_show_percentage="battery_show_percentage"
			bind_theme="battery_theme"
		/> -->

		<!--
			battery_indicator_v3: the widget-v2 feature set implemented as a single XML component.
			LVGL Pro 2.1 / LVGL 9.6 expressions and bindable properties update its visuals without custom widget C.
			Each instance owns its properties; expressions below connect application subjects to them.
			The != 0 comparisons convert the existing integer state subjects to boolean properties.
		-->
		<battery_indicator_v3
			align="right_mid"
			value="{battery_value}"
			charging="{battery_charging != 0}"
			low_power="{low_power_mode != 0}"
			show_percentage="{battery_show_percentage != 0}"
			theme="{battery_theme}"
			low_threshold="20"
		/>
	</view>
</component>
