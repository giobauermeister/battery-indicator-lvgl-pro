<component>
	<api>
		<prop name="text" type="string" />
		<prop name="subject" type="subject" />
		<prop name="enabled_color" type="color" />
	</api>
	<consts>
		<bool name="low_power" value="false" />
	</consts>
	<styles>
		<style name="style_main" shadow_width="0" radius="51" />
	</styles>
	<view extends="lv_button" width="300" height="90" style_bg_color="{subject == 0 ? 0xd3d1d1 : enabled_color}">
		<style name="style_main" />
		<lv_label text="$text" style_text_font="inter_28" style_text_color="0x474747" align="center" />
	</view>
</component>
